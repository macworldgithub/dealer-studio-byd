# Dealer Studio API Configuration
# Get your API key from Dealer Studio Dashboard or contact support@dealerstudio.com.au

DEALERSTUDIO_API_KEY=your_bearer_token_here
DEALERSTUDIO_DEALERSHIP_ID=your_dealership_id
DEALERSTUDIO_DEALERSHIP_SLUG=denza-melbourne
DEALERSTUDIO_COOKIE=
DEALERSTUDIO_CSRF_TOKEN=
DEALERSTUDIO_EMAIL=
DEALERSTUDIO_PASSWORD=
# Optional: the account owner's actual authenticator secret for unattended MFA.
# Without this, the CLI accepts a current code when Dealer Studio requests MFA.
DEALERSTUDIO_TOTP_SECRET=
DEALERSTUDIO_SESSION_FILE=.runtime/session.json
DEALERSTUDIO_BACKEND_ROOT=/var/www/shaun-backend
